  <!-- L7: the moving gripper jaw.
       L6.STL turned out to already contain the gripper jaws as two separate
       336-triangle shells, mirrored about y (+0.0110..+0.0215 and
       -0.0215..-0.0110), so the jaw is extracted into L7_jaw.STL rather than
       approximated with a box. L6 now renders L6_body.STL (everything else,
       including the opposite fixed jaw); the original mesh is kept as
       L6_original_backup.STL.

       Single-acting: one jaw moves, the other is fixed, which is how plenty
       of real grippers work and avoids a mimic joint (ign_ros2_control does
       not drive mimic joints reliably). Prismatic along +y, and the visual
       is pre-offset by -0.011 so that joint value 0.0 closes the 22mm gap
       and 0.011 returns the jaw to its modelled open position. That keeps
       the usual convention: 0 = closed, max = open. -->
  <link name="L7_R">
    <inertial>
      <origin xyz="0.045 0.0055 -0.0627" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia
        ixx="1.0E-06" ixy="0.0" ixz="0.0"
        iyy="1.0E-06" iyz="0.0"
        izz="1.0E-06" />
    </inertial>
    <visual>
      <origin xyz="0 -0.011 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm/meshes/L7_R_jaw.STL" />
      </geometry>
      <material name="">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
  </link>
  <joint
    name="joint_L7_R"
    type="prismatic">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="L6" />
    <child
      link="L7_R" />
    <axis
      xyz="0 1 0" />
    <!-- Damping is scaled to this link's mass, not copied from the arm.
         The arm joints run damping 50 against masses near 0.5kg, a ratio of
         about 100; this jaw is 0.01kg, so the equivalent ratio is 1.0.
         (An earlier revision set 0.05 while chasing a fault that turned out
         to be a controller that had never been spawned at all.) -->
    <!-- Upper limit is 0.013, not 0.011, while "fully open" stays 0.011.
         Commanding a joint to sit exactly ON its constraint boundary is
         fragile in Gazebo: the jaws would reach 0.011, fight the limit and
         settle back at 0, which read as the gripper closing itself at
         startup. The 2mm of headroom means the open pose is a normal
         interior position, never a boundary. -->
    <limit
      lower="0.0"
      upper="0.013"
      effort="50"
      velocity="0.5" />
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <!-- L8: the opposing gripper jaw. L6.STL held both jaws as separate
       336-triangle shells mirrored about y; L7 took the +y one, this takes
       the -y one, and L6_body.STL is now the wrist housing with neither.
       Travels along -y by the same amount L7 travels along +y, and is always
       commanded to the SAME value as L7, so the pair closes symmetrically on
       the centre line instead of one jaw swinging across to a fixed one.
       A URDF <mimic> would express this more directly, but gz_ros2_control
       does not drive mimic joints reliably, so it is an ordinary commanded
       joint kept in step in software. -->
  <link name="L7_L">
    <inertial>
      <origin xyz="0.045 -0.0055 -0.0627" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia
        ixx="1.0E-06" ixy="0.0" ixz="0.0"
        iyy="1.0E-06" iyz="0.0"
        izz="1.0E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0.011 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm/meshes/L7_L_jaw.STL" />
      </geometry>
      <material name="">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
  </link>
  <joint
    name="joint_L7_L"
    type="prismatic">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="L6" />
    <child
      link="L7_L" />
    <axis
      xyz="0 -1 0" />
    <!-- Upper limit is 0.013, not 0.011, while "fully open" stays 0.011.
         Commanding a joint to sit exactly ON its constraint boundary is
         fragile in Gazebo: the jaws would reach 0.011, fight the limit and
         settle back at 0, which read as the gripper closing itself at
         startup. The 2mm of headroom means the open pose is a normal
         interior position, never a boundary. -->
    <limit
      lower="0.0"
      upper="0.013"
      effort="50"
      velocity="0.5" />
    <dynamics damping="1.0" friction="0.1"/>
    <!-- Commanded, not a <mimic>. A mimic would express the constraint more
         directly, but gz_ros2_control does not support it: adding one stopped
         the model spawning entirely and neither jaw appeared in
         /joint_states. Both jaws are therefore ordinary commanded joints,
         always given the SAME value computed once, so they stay in step. -->
  </joint>

  <ros2_control name="robot_arm_hardware" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="joint_L1">
      <command_interface name="position">
        <param name="min">-1.7</param>
        <param name="max">1.7</param>
        <!-- Matches robot_node.py's HOME_POSE (and arm_gui.py's / load_controllers.py's
             own copies; these three are NOT imported from one shared source, see
             their own comments) so Gazebo spawns the robot AT home from its very
             first rendered frame, since ign_ros2_control applies this value the
             instant the plugin loads, independent of any ROS node. HOME_POSE is
             now all-zeros (a straight arm), reconsidered directly: "why initail
             postion of gazebo robort startup like this? is houdl be straight",
             was a folded reference pose (0.2565) before that. -->
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_L2">
      <command_interface name="position">
        <param name="min">-0.98</param>
        <param name="max">1.0</param>
        <!-- Matches HOME_POSE, see joint_L1's own comment above. -->
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_L3">
      <command_interface name="position">
        <param name="min">-2.0</param>
        <param name="max">1.3</param>
        <!-- Matches HOME_POSE, see joint_L1's own comment above. -->
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_L4">
      <command_interface name="position">
        <param name="min">-2.0</param>
        <param name="max">2.0</param>
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_L5">
      <command_interface name="position">
        <param name="min">-2.1</param>
        <param name="max">2.1</param>
        <!-- Matches HOME_POSE, see joint_L1's own comment above. -->
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_L6">
      <command_interface name="position">
        <param name="min">-3.1</param>
        <param name="max">3.1</param>
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_L7_R">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.013</param>
        <param name="initial_value">0.011</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_L7_L">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.013</param>
        <param name="initial_value">0.011</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find robot_arm)/config/gazebo_cm.yaml</parameters>
    </plugin>
  </gazebo> 

  <gazebo reference="L1">
    <selfCollide>false</selfCollide>
    <gravity>false</gravity>
  </gazebo>

  <gazebo reference="L2">
    <selfCollide>false</selfCollide>
    <gravity>false</gravity>
  </gazebo>

  <gazebo reference="L3">
    <selfCollide>false</selfCollide>
    <gravity>false</gravity>
  </gazebo>

  <gazebo reference="L4">
    <selfCollide>false</selfCollide>
    <gravity>false</gravity>
  </gazebo>

  <gazebo reference="L5">
    <selfCollide>false</selfCollide>
    <gravity>false</gravity>
  </gazebo>

  <gazebo reference="L6">
    <selfCollide>false</selfCollide>
    <gravity>false</gravity>
  </gazebo>

</robot>
